{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/jest-runner"],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.mjs",
    "config": {
      "testPathIgnorePatterns": ["<rootDir>/scripts/"]
    },
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/domain/phases.ts",
    "!src/testing/**"
  ],
  "ignorePatterns": [
    ".next",
    "coverage",
    "reports",
    "test-results",
    "backend",
    "e2e",
    "devtools"
  ],
  "concurrency": 2,
  "timeoutMS": 60000,
  "inPlace": true,
  "tempDirName": "../reports/mutation/frontend-sandbox",
  "cleanTempDir": true,
  "reporters": ["progress", "html", "json"],
  "htmlReporter": {
    "fileName": "../reports/mutation/frontend/index.html"
  },
  "jsonReporter": {
    "fileName": "../reports/mutation/frontend/report.json"
  },
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": null
  },
  "maxTestRunnerReuse": 20
}
